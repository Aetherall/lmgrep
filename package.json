		"@lumis-sh/wasm-zig": "^0.26.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"ai": "^6.0.149",
		"apache-arrow": "^21.1.0",
		"cli-progress": "^3.12.0",
		"commander": "^14.0.3",
		"glob": "^13.0.6",
		"ignore": "^7.0.5",
		"stemmer": "^2.0.1",
		"web-tree-sitter": "^0.26.9",
		"yaml": "^2.8.3",
